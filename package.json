{
  "name": "neutron-star-editor",
  "version": "1.0.0",
  "description": "A stable, neutral, and maintainable code editor",
  "main": "src/main/main.js",
  "productName": "Neutron Star Editor",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build-renderer": "esbuild src/renderer/index.js --bundle --outfile=src/renderer/bundle.js --platform=browser --format=esm",
    "package": "electron-builder"
  },
  "keywords": [
    "editor",
    "code",
    "neutron",
    "stable",
    "neat-open-code",
    "neutron-star-editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.1",
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-cpp": "6.0.0",
    "@codemirror/lang-css": "^6.1.2",
    "@codemirror/lang-go": "6.0.0",
    "@codemirror/lang-html": "^6.1.3",
    "@codemirror/lang-java": "6.0.0",
    "@codemirror/lang-javascript": "^6.1.4",
    "@codemirror/lang-python": "^6.1.2",
    "@codemirror/language": "^6.10.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.26.3",
    "@fortawesome/fontawesome-free": "^7.1.0",
    "codemirror": "^6.0.1",
    "file-icons-js": "^1.0.0",
    "fs-extra": "^11.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^22.3.27",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1",
    "esbuild": "^0.19.0"
  },
  "build": {
    "appId": "com.neutronstareditor.app",
    "productName": "Neutron Star Editor",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icons/icon.icns"
    },
    "win": {
      "icon": "assets/icons/icon.ico"
    },
    "linux": {
      "category": "Development",
      "icon": "assets/icons/"
    }
  }
}
